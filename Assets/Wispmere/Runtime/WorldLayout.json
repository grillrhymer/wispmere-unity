  "interactables": [
    { "id": "sign", "label": "Old Town Sign", "text": "The painted letters have faded, but someone carefully carved the town's name into the wood: Wispmere.", "x": 742, "y": 940, "r": 70 },
    { "id": "well", "label": "Abandoned Well", "text": "The water is clear\u2026 but nobody seems to be here.", "x": 800, "y": 470, "r": 90 },
    { "id": "shop", "label": "General Store", "text": "The door is locked. Dusty jars still line the window.", "x": 435, "y": 590, "r": 95 },
    { "id": "hall", "label": "Old Town Hall", "text": "The building is still standing. Someone swept the steps\u2026 recently?", "x": 970, "y": 425, "r": 110 },
    { "id": "inn", "label": "Restaurant", "text": "The dining room is still set, but the tables have gathered a fine coat of dust.", "x": 625, "y": 415, "r": 105 },
    { "id": "stall", "label": "Empty Market Stall", "text": "Vines curl through the slats. A price tag reads: 3 petals.", "x": 700, "y": 560, "r": 80 },
    { "id": "arch", "label": "Dormant Arch", "text": "A ring of cold crystal. Whatever it used to do, it is not doing it now.", "x": 970, "y": 530, "r": 90 },
